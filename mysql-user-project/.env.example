# Server Configuration
PORT=5006
NODE_ENV=development

# MySQL Database Configuration
# You can update these credentials whenever your MySQL server is ready
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mysql_user_db

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_mysql_user_2026
JWT_EXPIRES_IN=7d

# Nodemailer SMTP Configuration
# (If left empty, OTP codes will be logged to the server console and debug response for immediate testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MySQL User System" <noreply@mysqluser.com>

# Cloudinary Image Upload Settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=products
MAX_FILE_SIZE=5242880
